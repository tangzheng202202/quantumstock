# Database
DATABASE_URL="postgresql://user:password@localhost:5432/quantumstock"

# AI Models
ANTHROPIC_API_KEY="sk-ant-..."
OPENAI_API_KEY="sk-..."
DEEPSEEK_API_KEY="sk-..."
MINIMAX_API_KEY="..."

# Encryption secret for the HttpOnly API-key cookie (settings page keys).
# REQUIRED for multi-instance production deployments (all nodes must share it);
# single-instance deploys fall back to a per-process random key (keys are
# invalidated on restart). Generate: openssl rand -hex 32
KEY_ENCRYPTION_SECRET=""

# Encryption key for the DB-backed BYOK store (multi-device key sync;
# optional — requires DATABASE_URL). Must be ≥32 chars. Generate: openssl rand -hex 32
ENCRYPTION_KEY="change-me-to-a-random-32-char-string"

# Auth (Clerk — get keys from https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Market Data APIs
TUSHARE_TOKEN="..."
POLYGON_API_KEY="..."

# Redis (for caching)
REDIS_URL="redis://localhost:6379"

# Python Backend
PYTHON_ENGINE_URL="http://localhost:8000"
# CORS allowlist for the quant engine (comma-separated origins)
QS_ALLOWED_ORIGINS="http://localhost:3000"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="QuantumStock"

# QMT Sync (optional — for broker integration)
QMT_SYNC_TOKEN=""

# Ops dashboard (GET /api/ops/dashboard) — configure ONE of:
# ADMIN_EMAILS: comma-separated Clerk emails allowed to view
# OPS_DASHBOARD_TOKEN: query token (?token=...)
ADMIN_EMAILS=""
OPS_DASHBOARD_TOKEN=""
